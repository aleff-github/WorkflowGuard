{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflowguard.local/schemas/engagement.schema.json",
  "title": "WorkflowGuard authorized testing engagement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "engagementId",
    "status",
    "environment",
    "authorization",
    "scope",
    "identities",
    "execution",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "engagementId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
    },
    "status": {
      "enum": [
        "DRAFT",
        "APPROVED",
        "REVOKED"
      ]
    },
    "environment": {
      "enum": [
        "staging",
        "production"
      ]
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "reference",
        "approvedBy",
        "approvedAt",
        "notBefore",
        "notAfter"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "approvedBy": {
          "type": "string"
        },
        "approvedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "notBefore": {
          "type": "string",
          "format": "date-time"
        },
        "notAfter": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedOrigins",
        "excludedPathPrefixes",
        "allowRedirects",
        "allowedMethods"
      ],
      "properties": {
        "allowedOrigins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "excludedPathPrefixes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "allowRedirects": {
          "const": false
        },
        "allowedMethods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "GET",
              "HEAD",
              "OPTIONS",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          }
        }
      }
    },
    "identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "burpProjectReference"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "burpProjectReference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "maxCases",
        "maxRequestsPerCase",
        "delayMilliseconds",
        "concurrency",
        "stateChangingApproved",
        "cleanupRequired"
      ],
      "properties": {
        "mode": {
          "enum": [
            "DRY_RUN",
            "ACTIVE"
          ]
        },
        "maxCases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maxRequestsPerCase": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "delayMilliseconds": {
          "type": "integer",
          "minimum": 500,
          "maximum": 60000
        },
        "concurrency": {
          "const": 1
        },
        "stateChangingApproved": {
          "type": "boolean"
        },
        "cleanupRequired": {
          "type": "boolean"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputDirectory",
        "retentionDays"
      ],
      "properties": {
        "outputDirectory": {
          "const": "agy/output"
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        }
      }
    }
  }
}
